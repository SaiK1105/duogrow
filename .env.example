# Copy to .env — the app runs fully in demo mode without any of these.
# Server-only provider credentials: never commit a real key or expose one to web/.
# Existing proof verification + insights (Anthropic) uses this separate key:
ANTHROPIC_API_KEY=
# DuoGrow coaching uses OpenAI Responses; without this key, coaching stays in
# labelled deterministic demo mode. Keep this server-side only.
# A failed keyed call rolls its reservation back before returning demo content;
# no-key demo coaching remains subject to the normal application caps.
OPENAI_API_KEY=
# Coaching runtime controls. These server-side defaults are conservative; invalid
# values fall back to them. These are application guardrails, not price quotes.
OPENAI_MODEL=gpt-5-mini
AI_USER_DAILY_BUDGET_CENTS=3
AI_PROJECT_MONTHLY_BUDGET_CENTS=2500
AI_DAILY_CALLS_PER_USER=3
AI_TUTOR_CALLS_PER_USER=5
AI_CHAT_CALLS_PER_USER=10
AI_REFLECTIONS_PER_DUO_PER_WEEK=1
# Force the deterministic demo verifier even when a key is set (stage insurance):
DEMO_FAKE_AI=
# Models (defaults shown):
PROOF_MODEL=claude-opus-4-8
INSIGHTS_MODEL=claude-haiku-4-5
# Where SQLite + uploads live (default: ~/.duogrow — keep OUTSIDE OneDrive):
DATA_DIR=
# Local dev port for the server. Keep this set locally: the Claude browser
# preview harness injects PORT=5173, and the server falls back to PORT when
# API_PORT is unset — so API_PORT pins the API to 8787 and avoids a clash.
# On Render, leave this UNSET so Render's injected PORT is used instead.
API_PORT=8787
