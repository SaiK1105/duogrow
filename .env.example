# Copy to .env — the app runs fully in demo mode without any of these.
# Add a real key to light up live AI verification + insights.
ANTHROPIC_API_KEY=
# Force the deterministic demo verifier even when a key is set (stage insurance):
DEMO_FAKE_AI=
# Models (defaults shown):
PROOF_MODEL=claude-opus-4-8
INSIGHTS_MODEL=claude-haiku-4-5
# Where SQLite + uploads live (default: ~/.duogrow — keep OUTSIDE OneDrive):
DATA_DIR=
API_PORT=8787
