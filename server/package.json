{
  "name": "duogrow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts --serve-web",
    "seed": "tsx --env-file-if-exists=../.env src/seed.ts",
    "seed:if-empty": "tsx --env-file-if-exists=../.env src/seed.ts --if-empty",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@hono/node-server": "^2.0.10",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.31",
    "nanoid": "^6.0.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
